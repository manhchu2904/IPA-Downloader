+        uint32_t insn = *(volatile uint32_t *)pc;
+        if ((insn & 0xFFE0001Fu) == 0xD4200000u) {
+            uint32_t imm = (insn >> 5) & 0xFFFFu;
+            if (imm == 0x69u || imm == 0xF00Du) {
