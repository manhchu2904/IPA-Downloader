+                                mach_task_self(), (vm_address_t)rx_ptr, FALSE, &cur, &max,
+                                VM_INHERIT_NONE);
+    if (kr != KERN_SUCCESS) {
+        fprintf(stderr, "[unicorn-ios] %s: vm_remap RW failed kr=0x%x (%s)\n", label, (unsigned)kr, mach_error_string(kr));
+        return 0;
+    }
+    if (mprotect((void *)rw_addr, pool_size, PROT_READ | PROT_WRITE) != 0) {
+        fprintf(stderr, "[unicorn-ios] %s: mprotect(RW) errno=%d (%s); trying vm_protect\n", label, errno, strerror(errno));
+        kr = vm_protect(mach_task_self(), rw_addr, pool_size, FALSE, VM_PROT_READ | VM_PROT_WRITE);
+        if (kr != KERN_SUCCESS) {
+            fprintf(stderr, "[unicorn-ios] %s: vm_protect(RW) failed kr=0x%x\n", label, (unsigned)kr);
+            munmap((void *)rw_addr, pool_size);
+            return 0;
+        }
+    }
+    *out_rw = (uint8_t *)rw_addr;
+    return 1;
+}
+
+static int ipatool_commit_pool(uint8_t *rw, uint8_t *rx, size_t pool_size, int slots, const char *source)
+{
+    ipatool_pool_size = pool_size;
+    ipatool_pool_slots = slots;
+    ipatool_pool_rx_diff = rx - rw;
+    __atomic_store_n(&ipatool_pool_used_mask, 0u, __ATOMIC_RELEASE);
+    __atomic_store_n(&ipatool_pool_rx_base, rx, __ATOMIC_RELEASE);
+    __atomic_store_n(&ipatool_pool_rw_base, rw, __ATOMIC_RELEASE);
+    __atomic_store_n(&ipatool_jit_mode, 4, __ATOMIC_RELEASE);
+    fprintf(stderr, "[unicorn-ios] JIT pool READY (%s): rw=%p rx=%p diff=%td size=%zu slots=%d\n",
+            source, (void *)rw, (void *)rx, ipatool_pool_rx_diff, pool_size, slots);
+    return 1;
+}
+
+__attribute__((visibility("default")))
+int ipatool_jit_pool_ready(void)
+{
+    return (__atomic_load_n(&ipatool_pool_rw_base, __ATOMIC_ACQUIRE) != NULL &&
+            __atomic_load_n(&ipatool_pool_rx_base, __ATOMIC_ACQUIRE) != NULL) ? 1 : 0;
+}
+
+__attribute__((visibility("default")))
+ptrdiff_t ipatool_rx_diff_for_rw(const void *rw_addr)
+{
+    const uint8_t *rw_base = __atomic_load_n(&ipatool_pool_rw_base, __ATOMIC_ACQUIRE);
+    if (rw_base != NULL && rw_addr != NULL) {
+        const uint8_t *p = (const uint8_t *)rw_addr;
+        if (p >= rw_base && p < rw_base + ipatool_pool_size) {
+            return ipatool_pool_rx_diff;
+        }
+    }
+    return 0;
+}
+
+__attribute__((visibility("default")))
+int ipatool_jit26_init_pool(size_t pool_size)
+{
+    pthread_mutex_lock(&ipatool_pool_lock);
+    if (ipatool_jit_pool_ready()) {
+        pthread_mutex_unlock(&ipatool_pool_lock);
+        return 1;
+    }
+
+    if (pool_size < IPATOOL_JIT26_SLOT_SIZE) {
+        pool_size = IPATOOL_JIT26_SLOT_SIZE;
+    }
+    int slots = (int)(pool_size / IPATOOL_JIT26_SLOT_SIZE);
+    if (slots > IPATOOL_JIT26_MAX_SLOTS) {
+        slots = IPATOOL_JIT26_MAX_SLOTS;
+    }
+    pool_size = (size_t)slots * IPATOOL_JIT26_SLOT_SIZE;
+
+#if defined(__aarch64__)
+    /* Tier 1: StikDebug universal.js breakpoint RPC (brk #0x69 / brk #0xf00d), guarded by SIGTRAP handler */
+    ipatool_install_trap_guard();
+    uint64_t probe = ipatool_brk_probe();
+    int probe_unanswered = ipatool_trap_unanswered;
+    ipatool_remove_trap_guard();
+
+    if (!probe_unanswered && probe != 0) {
+        fprintf(stderr, "[unicorn-ios] Tier 1: brk #0x69 answered (0x%llx), requesting %zu bytes\n",
+                (unsigned long long)probe, pool_size);
+        ipatool_install_trap_guard();
+        void *rx = ipatool_jit26_prepare_region(NULL, pool_size);
+        int req_unanswered = ipatool_trap_unanswered;
+        ipatool_remove_trap_guard();
+
+        if (!req_unanswered && rx != NULL && rx != MAP_FAILED) {
+            uint8_t *rw = NULL;
+            if (ipatool_try_alias_rw_for_rx(rx, pool_size, "Tier1", &rw)) {
+                ipatool_install_trap_guard();
+                ipatool_jit26_detach();
+                ipatool_remove_trap_guard();
+
+                if (ipatool_dualmap_selftest(rw, (uint8_t *)rx, "Tier1-brk26")) {
+                    ipatool_commit_pool(rw, (uint8_t *)rx, pool_size, slots, "Tier1-brk26");
+                    pthread_mutex_unlock(&ipatool_pool_lock);
+                    return 1;
+                }
+                munmap(rw, pool_size);
+            } else {
+                ipatool_install_trap_guard();
+                ipatool_jit26_detach();
+                ipatool_remove_trap_guard();
+            }
+            munmap(rx, pool_size);
+        } else {
+            fprintf(stderr, "[unicorn-ios] Tier 1: prepare failed (unanswered=%d, rx=%p)\n",
+                    req_unanswered, rx);
+        }
+    } else {
+        fprintf(stderr, "[unicorn-ios] Tier 1: no brk #0x69 servicer (unanswered=%d, probe=0x%llx)\n",
+                probe_unanswered, (unsigned long long)probe);
+    }
+#endif
+
+    int debugged = ipatool_cs_debugged();
+    int jailbroken = (access("/var/jb", F_OK) == 0);
+    if (debugged || jailbroken) {
+        /* Tier 2A: mmap(RW) -> vm_remap(RX) -> mprotect(RX) [LinuxRunner / DolphiniOS classic] */
+        void *rw2a = mmap(NULL, pool_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+        if (rw2a != MAP_FAILED) {
+            vm_address_t rx_addr = 0;
+            vm_prot_t cur = 0, max = 0;
+            kern_return_t kr = vm_remap(mach_task_self(), &rx_addr, pool_size, 0, VM_FLAGS_ANYWHERE,
+                                        mach_task_self(), (vm_address_t)rw2a, FALSE, &cur, &max,
+                                        VM_INHERIT_NONE);
+            if (kr == KERN_SUCCESS) {
+                if (mprotect((void *)rx_addr, pool_size, PROT_READ | PROT_EXEC) == 0 ||
+                    vm_protect(mach_task_self(), rx_addr, pool_size, FALSE, VM_PROT_READ | VM_PROT_EXECUTE) == KERN_SUCCESS) {
+                    if (ipatool_dualmap_selftest((uint8_t *)rw2a, (uint8_t *)rx_addr, "Tier2A-RW->RX")) {
+                        ipatool_commit_pool((uint8_t *)rw2a, (uint8_t *)rx_addr, pool_size, slots, "Tier2A-RW->RX");
+                        pthread_mutex_unlock(&ipatool_pool_lock);
+                        return 1;
+                    }
+                } else {
+                    fprintf(stderr, "[unicorn-ios] Tier2A: protect RX failed errno=%d (%s)\n", errno, strerror(errno));
+                }
+                munmap((void *)rx_addr, pool_size);
+            } else {
+                fprintf(stderr, "[unicorn-ios] Tier2A: vm_remap RX failed kr=0x%x\n", (unsigned)kr);
+            }
+            munmap(rw2a, pool_size);
+        }
+
+        /* Tier 2B: mmap(RX) -> vm_remap(RW) -> mprotect(RW) [Flycast-iOS vmem_no_txm] */
+        void *rx2b = mmap(NULL, pool_size, PROT_READ | PROT_EXEC, MAP_PRIVATE | MAP_ANON, -1, 0);
+        if (rx2b != MAP_FAILED) {
+            uint8_t *rw2b = NULL;
+            if (ipatool_try_alias_rw_for_rx(rx2b, pool_size, "Tier2B-RX->RW", &rw2b)) {
+                if (ipatool_dualmap_selftest(rw2b, (uint8_t *)rx2b, "Tier2B-RX->RW")) {
+                    ipatool_commit_pool(rw2b, (uint8_t *)rx2b, pool_size, slots, "Tier2B-RX->RW");
+                    pthread_mutex_unlock(&ipatool_pool_lock);
+                    return 1;
+                }
+                munmap(rw2b, pool_size);
+            }
+            munmap(rx2b, pool_size);
+        } else {
+            fprintf(stderr, "[unicorn-ios] Tier2B: mmap(RX) failed errno=%d (%s)\n", errno, strerror(errno));
+        }
+
+        /* Tier 2C: mmap(RWX) -> vm_remap(RW) -> vm_protect(rx, RX) [Husk plain] */
+        void *rx2c = mmap(NULL, pool_size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANON, -1, 0);
+        if (rx2c != MAP_FAILED) {
+            uint8_t *rw2c = NULL;
+            if (ipatool_try_alias_rw_for_rx(rx2c, pool_size, "Tier2C-RWX->RW", &rw2c)) {
+                if (mprotect(rx2c, pool_size, PROT_READ | PROT_EXEC) == 0 ||
+                    vm_protect(mach_task_self(), (vm_address_t)rx2c, pool_size, FALSE, VM_PROT_READ | VM_PROT_EXECUTE) == KERN_SUCCESS) {
+                    if (ipatool_dualmap_selftest(rw2c, (uint8_t *)rx2c, "Tier2C-RWX->RW")) {
+                        ipatool_commit_pool(rw2c, (uint8_t *)rx2c, pool_size, slots, "Tier2C-RWX->RW");
+                        pthread_mutex_unlock(&ipatool_pool_lock);
+                        return 1;
+                    }
+                }
+                munmap(rw2c, pool_size);
+            }
+            munmap(rx2c, pool_size);
+        }
+    } else {
+        fprintf(stderr, "[unicorn-ios] Tier 2 skipped (CS_DEBUGGED=0, jailbroken=0)\n");
+    }
+
+    /* Tier 3: MAP_JIT (0x0800) + vm_remap dual-mapping */
+    void *rx3 = mmap(NULL, pool_size, PROT_READ | PROT_WRITE | PROT_EXEC,
+                     MAP_PRIVATE | MAP_ANON | 0x0800, -1, 0);
+    if (rx3 != MAP_FAILED) {
+        uint8_t *rw3 = NULL;
+        if (ipatool_try_alias_rw_for_rx(rx3, pool_size, "Tier3-MAP_JIT", &rw3)) {
+            if (vm_protect(mach_task_self(), (vm_address_t)rx3, pool_size, FALSE, VM_PROT_READ | VM_PROT_EXECUTE) == KERN_SUCCESS &&
+                ipatool_dualmap_selftest(rw3, (uint8_t *)rx3, "Tier3-MAP_JIT")) {
+                ipatool_commit_pool(rw3, (uint8_t *)rx3, pool_size, slots, "Tier3-MAP_JIT");
+                pthread_mutex_unlock(&ipatool_pool_lock);
+                return 1;
+            }
+            munmap(rw3, pool_size);
+        }
+        munmap(rx3, pool_size);
+    } else {
+        fprintf(stderr, "[unicorn-ios] Tier3: mmap(MAP_JIT) refused errno=%d (%s)\n", errno, strerror(errno));
+    }
+
+    pthread_mutex_unlock(&ipatool_pool_lock);
+    return 0;
+}
+
+static void *ipatool_pool_alloc(size_t size)
+{
+    uint8_t *rw_base = __atomic_load_n(&ipatool_pool_rw_base, __ATOMIC_ACQUIRE);
+    if (rw_base == NULL || size > IPATOOL_JIT26_SLOT_SIZE) {
+        return NULL;
+    }
+    for (;;) {
+        uint32_t mask = __atomic_load_n(&ipatool_pool_used_mask, __ATOMIC_ACQUIRE);
+        int found = -1;
+        for (int i = 0; i < ipatool_pool_slots; i++) {
+            if ((mask & (1u << i)) == 0) {
+                found = i;
+                break;
+            }
+        }
+        if (found < 0) {
+            return NULL;
+        }
+        if (__atomic_compare_exchange_n(&ipatool_pool_used_mask, &mask, mask | (1u << found),
+                                        0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+            return rw_base + ((size_t)found * IPATOOL_JIT26_SLOT_SIZE);
+        }
+    }
+}
+
+static int ipatool_pool_free(void *ptr)
+{
+    uint8_t *rw_base = __atomic_load_n(&ipatool_pool_rw_base, __ATOMIC_ACQUIRE);
+    if (rw_base == NULL || ptr == NULL) {
+        return 0;
+    }
+    uint8_t *p = (uint8_t *)ptr;
+    if (p < rw_base || p >= rw_base + ipatool_pool_size) {
+        return 0;
+    }
+    size_t offset = (size_t)(p - rw_base);
+    int idx = (int)(offset / IPATOOL_JIT26_SLOT_SIZE);
+    if (idx >= 0 && idx < ipatool_pool_slots) {
+        __atomic_fetch_and(&ipatool_pool_used_mask, ~(1u << idx), __ATOMIC_RELEASE);
+    }
+    return 1;
+}
+
+typedef int (*ipatool_jit_supported_fn)(void);
+typedef void (*ipatool_jit_protect_fn)(int);
+static ipatool_jit_supported_fn ipatool_supported_fn = NULL;
+static ipatool_jit_protect_fn ipatool_protect_fn = NULL;
+static pthread_once_t ipatool_jit_once = PTHREAD_ONCE_INIT;
+
+static void ipatool_resolve_jit_fns(void)
+{
+    ipatool_supported_fn = (ipatool_jit_supported_fn)dlsym(RTLD_DEFAULT, "pthread_jit_write_protect_supported_np");
+    ipatool_protect_fn = (ipatool_jit_protect_fn)dlsym(RTLD_DEFAULT, "pthread_jit_write_protect_np");
+}
+
+__attribute__((visibility("default")))
+void ipatool_jit_write_protect(struct uc_struct *uc, int enabled)
+{
+    TCGContext *ctx = uc->tcg_ctx;
+    int mode = __atomic_load_n(&ipatool_jit_mode, __ATOMIC_ACQUIRE);
+    if (ctx && ctx->splitwx_diff != 0) {
+        return;
+    }
+    if (mode == 1) {
+        pthread_once(&ipatool_jit_once, ipatool_resolve_jit_fns);
+        if (ipatool_supported_fn && ipatool_protect_fn && ipatool_supported_fn()) {
+            ipatool_protect_fn(enabled);
+        }
+        return;
+    }
+    if (ctx && ctx->initial_buffer) {
+        if (mprotect(ctx->initial_buffer, ctx->initial_buffer_size,
+                     PROT_READ | (enabled ? PROT_EXEC : PROT_WRITE)) != 0) {
+            fprintf(stderr, "[unicorn-ios] mprotect(enabled=%d) failed errno=%d\n", enabled, errno);
+            perror("protect Unicorn translation buffer");
+        } else if (enabled) {
+            sys_icache_invalidate(ctx->initial_buffer, ctx->initial_buffer_size);
+        }
+    }
+}
