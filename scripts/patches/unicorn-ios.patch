+static int ipatool_dualmap_selftest(uint8_t *rw, uint8_t *rx, const char *label)
+{
+    /* Pass 1: movz w0, #0x5a5a ; ret */
+    static const uint32_t kCode1[2] = { 0x528B4B40u, 0xD65F03C0u };
+    /* Pass 2: movz w0, #0x1234 ; ret */
+    static const uint32_t kCode2[2] = { 0x52824680u, 0xD65F03C0u };
+
+    if (!rw || !rx) {
+        return 0;
+    }
+
+    vm_prot_t cur_rx = 0, max_rx = 0, cur_rw = 0, max_rw = 0;
+    int has_exec = ipatool_page_has_exec(rx, &cur_rx, &max_rx);
+    (void)ipatool_page_has_exec(rw, &cur_rw, &max_rw);
+    fprintf(stderr, "[unicorn-ios] %s: rw=%p (prot=0x%x/0x%x) rx=%p (prot=0x%x/0x%x exec=%d)\n",
+            label, (void *)rw, (unsigned)cur_rw, (unsigned)max_rw,
+            (void *)rx, (unsigned)cur_rx, (unsigned)max_rx, has_exec);
+    if (!has_exec) {
+        return 0;
+    }
+
+    struct sigaction sa, prev_bus, prev_segv, prev_ill;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_handler = ipatool_selftest_fault;
+    sa.sa_flags = SA_ONSTACK;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGBUS, &sa, &prev_bus);
+    sigaction(SIGSEGV, &sa, &prev_segv);
+    sigaction(SIGILL, &sa, &prev_ill);
+
+    volatile int ok = 0;
+    int fault_sig = sigsetjmp(ipatool_selftest_jmp, 1);
+    if (fault_sig == 0) {
+        ipatool_selftest_active = 1;
+
+        memcpy(rw, kCode1, sizeof(kCode1));
+        sys_icache_invalidate(rw, sizeof(kCode1));
+        sys_icache_invalidate(rx, sizeof(kCode1));
+
+        uint32_t rb1[2] = {0, 0};
+        memcpy(rb1, rx, sizeof(rb1));
+        if (rb1[0] != kCode1[0] || rb1[1] != kCode1[1]) {
+            fprintf(stderr, "[unicorn-ios] %s: pass1 readback mismatch\n", label);
+            goto done;
+        }
+        int (*fn1)(void) = (int (*)(void))(void *)rx;
+        int r1 = fn1();
+        if (r1 != 0x5a5a) {
+            fprintf(stderr, "[unicorn-ios] %s: pass1 returned 0x%x != 0x5a5a\n", label, r1);
+            goto done;
+        }
+
+        memcpy(rw + 16, kCode2, sizeof(kCode2));
+        sys_icache_invalidate(rw + 16, sizeof(kCode2));
+        sys_icache_invalidate(rx + 16, sizeof(kCode2));
+
+        int (*fn2)(void) = (int (*)(void))(void *)(rx + 16);
+        int r2 = fn2();
+        if (r2 != 0x1234) {
+            fprintf(stderr, "[unicorn-ios] %s: pass2 returned 0x%x != 0x1234\n", label, r2);
+            goto done;
+        }
+
+        memset(rw, 0, 32);
+        sys_icache_invalidate(rw, 32);
+        sys_icache_invalidate(rx, 32);
+        ok = 1;
+    } else {
+        fprintf(stderr, "[unicorn-ios] %s: selftest faulted with sig=%d\n", label, fault_sig);
+    }
+
+done:
+    ipatool_selftest_active = 0;
+    sigaction(SIGBUS, &prev_bus, NULL);
+    sigaction(SIGSEGV, &prev_segv, NULL);
+    sigaction(SIGILL, &prev_ill, NULL);
+    if (ok) {
+        fprintf(stderr, "[unicorn-ios] %s: selftest PASS (2-pass verified)\n", label);
+    }
+    return ok;
+}
