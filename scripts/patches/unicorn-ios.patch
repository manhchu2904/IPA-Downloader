+void ipatool_jit_write_protect(struct uc_struct *uc, int enabled)
+{
+    int mode = __atomic_load_n(&ipatool_jit_mode, __ATOMIC_ACQUIRE);
+    if (mode == 1) {
+        pthread_once(&ipatool_jit_once, ipatool_resolve_jit_fns);
+        if (ipatool_supported_fn && ipatool_protect_fn && ipatool_supported_fn()) {
+            ipatool_protect_fn(enabled);
+        }
+        return;
+    }
+    TCGContext *ctx = uc->tcg_ctx;
+    if (mode == 4) {
+        if (enabled && ctx && ctx->initial_buffer) {
+            sys_icache_invalidate(ctx->initial_buffer, ctx->initial_buffer_size);
+        }
+        return;
+    }
+    if (ctx && ctx->initial_buffer) {
+        if (mprotect(ctx->initial_buffer, ctx->initial_buffer_size,
