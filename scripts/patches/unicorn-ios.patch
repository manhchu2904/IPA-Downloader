+static void ipatool_selftest_fault(int sig)
+{
+    if (ipatool_selftest_active) {
+        siglongjmp(ipatool_selftest_jmp, sig ? sig : -1);
+    }
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
