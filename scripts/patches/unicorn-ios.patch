+static int ipatool_page_has_exec(void *p, vm_prot_t *out_prot, vm_prot_t *out_max_prot)
+{
+    vm_address_t addr = (vm_address_t)p;
+    vm_size_t size = 0;
+    natural_t depth = 0;
+    vm_region_submap_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_COUNT_64;
+    kern_return_t kr = vm_region_recurse_64(mach_task_self(), &addr, &size, &depth,
+                                            (vm_region_recurse_info_t)&info, &count);
+    if (kr != KERN_SUCCESS) {
+        if (out_prot) *out_prot = 0;
+        if (out_max_prot) *out_max_prot = 0;
+        return 0;
+    }
+    if (out_prot) *out_prot = info.protection;
+    if (out_max_prot) *out_max_prot = info.max_protection;
+    return (info.protection & VM_PROT_EXECUTE) != 0;
+}
